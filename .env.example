# Sao chép tệp này thành .env rồi điền giá trị thật.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./mathai.sqlite

# Tạo khóa ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Không bắt buộc để chạy web/làm bài. Bắt buộc để bật các tính năng gia sư AI.
# Lấy API key từ bảng điều khiển OpenAI; không đặt khóa trong public/app.js.
OPENAI_API_KEY=
# Model chất lượng cao mặc định của bản mẫu; có thể đổi sang model khác mà tài khoản API được cấp quyền.
OPENAI_MODEL=gpt-5.5
